{
  "name": "tamtam",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "next dev --port 1337 --hostname 127.0.0.1",
    "dev:qa": "docker compose -f docker-compose.qa.yml up --build",
    "rebuild": "bash scripts/rebuild-safe.sh",
    "rebuild:force": "TAMTAM_REBUILD_FORCE=1 bash scripts/rebuild-safe.sh",
    "predev:profile": "pm2 delete tamtam 2>/dev/null; lsof -ti:1337 | xargs kill -9 2>/dev/null; rm -f .next/dev/trace-turbopack; true",
    "dev:profile": "NEXT_TURBOPACK_TRACING=1 pm2 start 'next dev --port 1337 --hostname 127.0.0.1' --name tamtam --cwd . --time --update-env && echo '\\n[dev:profile] reproduce the slow state, then `pnpm stop` to flush the trace to .next/dev/trace-turbopack — view via `npx next internal trace .next/dev/trace-turbopack` then open https://trace.nextjs.org/\\n' && pm2 logs tamtam",
    "predev:flamegraph": "pm2 delete tamtam 2>/dev/null; lsof -ti:1337 | xargs kill -9 2>/dev/null; mkdir -p .profiles && rm -f .profiles/CPU.*.cpuprofile; true",
    "dev:flamegraph": "pm2 start node --name tamtam --cwd . --time --update-env --interpreter none -- --cpu-prof --cpu-prof-dir=./.profiles ./node_modules/next/dist/bin/next dev --port 1337 --hostname 127.0.0.1 && echo '\\n[dev:flamegraph] reproduce the slow state, then `pnpm stop` to flush the V8 CPU profile to ./.profiles/CPU.*.cpuprofile — open in Chrome DevTools (Performance → Load profile) or drop into https://www.speedscope.app/ for a flamegraph view\\n' && pm2 logs tamtam",
    "stop": "pm2 stop tamtam",
    "logs": "pm2 logs tamtam",
    "mcp:http": "node scripts/mcp-http-tools-call.mjs",
    "backfill:issue-run-summaries": "node scripts/backfill-issue-run-summaries.mjs",
    "backfill:issue-cruncher-numbers": "node scripts/backfill-issue-cruncher-numbers.mjs",
    "check:summary-extraction": "node scripts/check-summary-extraction.mjs",
    "peek:summary": "node scripts/peek-summary.mjs",
    "gen:workflow-graph": "node scripts/gen-workflow-graph.mjs",
    "build": "node scripts/build-with-metrics.mjs",
    "build:turbopack": "TAMTAM_BUILD_BUNDLER=turbopack TAMTAM_BUILD_LABEL=turbopack node scripts/build-with-metrics.mjs",
    "build:webpack-test": "TAMTAM_BUILD_BUNDLER=webpack TAMTAM_DIST_DIR=.next-webpack-test TAMTAM_BUILD_LABEL=webpack-test node scripts/build-with-metrics.mjs",
    "build:raw": "NODE_ENV=production next build",
    "build:debug": "NODE_ENV=production next build --debug",
    "build:cpu-prof": "NODE_ENV=production next build --experimental-cpu-prof",
    "build:memory": "NODE_ENV=production next build --experimental-debug-memory-usage",
    "build:history": "node scripts/build-history.mjs",
    "build:strip-runtime-data": "node scripts/strip-runtime-data-from-nft.mjs",
    "build:check-nft-sizes": "node scripts/check-nft-sizes.mjs",
    "start": "bash scripts/pm2-start.sh",
    "restart": "pnpm build && bash scripts/pm2-start.sh",
    "type-check": "tsc --noEmit",
    "test": "node scripts/run-vitest-shards.mjs",
    "test:watch": "vitest --no-color",
    "test:e2e": "playwright test",
    "test:e2e:pipeline": "playwright test --config playwright.pipeline.config.ts",
    "check": "pnpm lint && pnpm type-check && pnpm test",
    "lint": "eslint --cache app components lib hooks",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:verify": "node scripts/db-verify.js",
    "db:restore": "node scripts/db-restore.js",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24 <26"
  },
  "packageManager": "pnpm@11.1.2",
  "dependencies": {
    "@workflow/next": "4.0.11",
    "@workflow/world-postgres": "4.2.0",
    "cbor-x": "^1.6.4",
    "devalue": "^5.8.1",
    "drizzle-orm": "^0.45.2",
    "glob": "^13.0.6",
    "next": "^16.2.9",
    "pg": "^8.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "recharts": "3.8.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "workflow": "4.5.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@mermaid-js/mermaid-cli": "^11.15.0",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitejs/plugin-react": "^6.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.5.0",
    "eslint-config-next": "^16.2.9",
    "graphile-worker": "0.16.6",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "semantic-release": "25.0.5",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.2",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}

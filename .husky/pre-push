#!/usr/bin/env sh
# Pre-push gate: lint + type-check + tests must pass before a push is allowed.
# This mirrors CI's "Lint and Test" job — if anything fails here, CI will too,
# so failing fast saves a wasted CI run and a red merge queue.
#
# To skip in a real emergency: `git push --no-verify`. Use sparingly: bypassing
# this hook is how lint/type/test regressions reach master.
#
# Husky executes hooks with `sh`, so this file must stay POSIX-compatible.
set -eu

run_step() {
    label="$1"
    shift
    printf "\033[1;34m→ %s\033[0m\n" "$label"
    if ! "$@"; then
        printf "\n\033[1;31m✗ %s failed.\033[0m\n" "$label"
        case "$label" in
            lint) printf "  Try: \033[1mpnpm exec eslint --fix app components lib hooks\033[0m\n" ;;
            type-check) printf "  Run \033[1mpnpm type-check\033[0m to see the full list.\n" ;;
            tests) printf "  Run \033[1mpnpm test\033[0m to reproduce locally.\n" ;;
        esac
        printf "  To bypass in an emergency only: \033[1mgit push --no-verify\033[0m\n\n"
        exit 1
    fi
}

run_step lint pnpm lint
run_step type-check pnpm type-check
run_step tests pnpm test
